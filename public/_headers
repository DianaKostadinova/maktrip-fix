# Cloudflare Pages / Netlify response headers (ignored by nginx/Docker,
# which sets the same rules in docker/web/nginx.conf.template).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN

# App shell, service worker and runtime config must never be stale.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache

# Hashed build output: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000
/icons/*
  Cache-Control: public, max-age=2592000
