# Copy to .env and fill in. Used by `npm run dev` (Vite) AND by docker compose
# (injected at container start, so one image works for every environment).
# Firebase web config is public by design; protect data with Firestore rules
# (see firebase/firestore.rules), not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: avatar uploads (https://api.imgbb.com/). Leave empty to disable.
VITE_IMGBB_API_KEY=

# Where the website finds the API. Leave empty when they share a domain (Docker).
# Free hosting (Cloudflare Pages + Render): the Render URL, e.g. https://discover-macedonia-api.onrender.com
VITE_API_BASE_URL=

# --- AI trip planner ("coming soon" while false) ---
# true = show the planner and let the API call Ollama.
PLANNER_ENABLED=false
VITE_PLANNER_ENABLED=false
# Where the backend finds Ollama. Default uses Ollama installed on your machine.
# To run Ollama inside Docker instead: `docker compose --profile ollama up`
# and set OLLAMA_URL=http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Port the site is published on (http://localhost:8080)
WEB_PORT=8080
